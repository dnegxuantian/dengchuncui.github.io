.legacy-image-notice
  overflow hidden
  margin 1.75rem auto
  border 1px solid var(--color-text-a10)
  border-radius 12px
  background var(--color-block)

.legacy-image-notice img
  display block
  width 100%
  margin 0 !important
  border-radius 0 !important
  box-shadow none !important

.legacy-image-notice figcaption
  padding .8rem 1rem
  color var(--color-meta)
  font-family "SFMono-Regular", "JetBrains Mono", Consolas, monospace
  font-size .75rem
  line-height 1.55

.legacy-image-notice figcaption strong
  color var(--color-text)

.home-seo-title
  display flex
  flex-direction column
  align-items center
  gap 0
  text-wrap balance

.home-seo-title .home-brand-name
  font-family "Avenir Next", "Helvetica Neue", "PingFang SC", sans-serif
  font-size clamp(2.4rem, 6vw, 4.6rem)
  font-weight 700
  letter-spacing .04em
  line-height 1
  transform translateX(.02em)

.home-seo-title .home-brand-author,
.home-seo-title .home-brand-domain
  font-family "SFMono-Regular", "JetBrains Mono", Consolas, monospace
  line-height 1.4

.home-seo-title .home-brand-author
  margin-top .55rem
  font-size clamp(.68rem, 1.15vw, .82rem)
  font-weight 600
  letter-spacing .18em

.home-seo-title .home-brand-domain
  margin-top 1rem
  font-size clamp(.78rem, 1.25vw, .92rem)
  font-weight 600
  letter-spacing .08em
  opacity .85

@media screen and (max-width: 600px)
  .legacy-image-notice figcaption
    font-size .68rem

  .home-seo-title
    max-width 22rem
    margin 0 auto

  .home-seo-title .home-brand-name
    font-size 2.25rem

  .home-seo-title .home-brand-author
    margin-top .45rem
    font-size .65rem

  .home-seo-title .home-brand-domain
    margin-top .8rem
    font-size .72rem
    letter-spacing .06em

// Personal brand profile page
.brand-profile
  --brand-line var(--color-text-a10)
  --brand-muted var(--color-meta)
  color var(--color-text)

.brand-profile *
  box-sizing border-box

.brand-profile h1,
.brand-profile h2,
.brand-profile h3,
.brand-profile p
  margin-top 0

.brand-profile h2,
.brand-profile h3
  text-wrap balance

.brand-profile p
  text-wrap pretty

.brand-hero
  display grid
  grid-template-columns minmax(0, 1.35fr) minmax(220px, .65fr)
  gap clamp(1.75rem, 5vw, 4.5rem)
  align-items center
  overflow hidden
  padding clamp(1.75rem, 5vw, 4.5rem)
  border 1px solid var(--brand-line)
  border-radius 24px
  background radial-gradient(circle at 86% 12%, var(--theme-a20), transparent 38%), var(--color-block)

.brand-eyebrow,
.brand-section-label
  margin-bottom .7rem !important
  color var(--theme)
  font-family "SFMono-Regular", "JetBrains Mono", Consolas, monospace
  font-size .7rem
  font-weight 700
  letter-spacing .14em

.brand-hero h1
  margin-bottom .7rem
  color var(--color-h1)
  font-size clamp(2.3rem, 6vw, 4.4rem)
  line-height 1
  letter-spacing -.055em

.brand-hero h1 small
  display block
  margin-top .7rem
  color var(--brand-muted)
  font-size .26em
  font-weight 600
  letter-spacing .04em

.brand-title
  margin-bottom 1.35rem !important
  color var(--color-h2)
  font-size clamp(1.05rem, 2.2vw, 1.35rem)
  font-weight 650

.brand-statement
  max-width 39rem
  margin-bottom 1.55rem !important
  padding-left 1rem
  border-left 3px solid var(--theme)
  color var(--color-p)
  font-size clamp(1.05rem, 2vw, 1.25rem)
  line-height 1.85

.brand-facts
  display flex
  flex-wrap wrap
  gap .45rem 1.25rem
  color var(--brand-muted)
  font-family "SFMono-Regular", "JetBrains Mono", Consolas, monospace
  font-size .72rem

.brand-facts span
  position relative

.brand-facts span:not(:last-child)::after
  position absolute
  right -.76rem
  color var(--theme-a50)
  content "/"

.brand-portrait
  margin 0

.brand-portrait img
  display block
  width 100%
  aspect-ratio 1
  object-fit cover
  border 1px solid var(--theme-a20)
  border-radius 18px
  box-shadow 0 22px 50px var(--theme-a20)

.brand-intro,
.brand-section
  padding clamp(4.5rem, 9vw, 7.5rem) clamp(.25rem, 3vw, 2.2rem) 0

.brand-intro
  display grid
  grid-template-columns minmax(180px, .42fr) 1fr
  column-gap clamp(1.5rem, 5vw, 4.5rem)

.brand-intro .brand-section-label,
.brand-intro h2
  grid-column 1

.brand-intro h2,
.brand-section__header h2,
.brand-difference h2,
.brand-proof h2,
.brand-citation h2,
.brand-contact h2
  margin-bottom .85rem
  color var(--color-h2)
  font-size clamp(1.7rem, 3.5vw, 2.55rem)
  line-height 1.18
  letter-spacing -.035em

.brand-intro > p:not(.brand-section-label)
  grid-column 2
  max-width 48rem
  margin-bottom 1rem
  color var(--color-p)
  font-size 1rem
  line-height 1.95

.brand-intro .brand-intro__answer
  color var(--color-text)
  font-size clamp(1.12rem, 2vw, 1.32rem)
  line-height 1.9

.brand-intro strong
  color var(--color-h3)

.brand-thesis
  margin clamp(4.5rem, 9vw, 7.5rem) 0 0
  padding clamp(2rem, 6vw, 4rem)
  border-left 4px solid var(--theme)
  border-radius 4px 20px 20px 4px
  background var(--color-block)

.brand-thesis p
  max-width 52rem
  margin-bottom 1.25rem
  color var(--color-h2)
  font-size clamp(1.5rem, 4vw, 2.7rem)
  font-weight 700
  line-height 1.45
  letter-spacing -.03em

.brand-thesis span
  color var(--brand-muted)
  font-size .8rem

.brand-section__header
  max-width 52rem
  margin-bottom 2rem

.brand-section__header > p:last-child
  color var(--color-p)
  line-height 1.85

.brand-coordinate
  display grid
  grid-template-columns 1.18fr .91fr .91fr
  gap 1rem

.brand-coordinate article
  padding clamp(1.4rem, 3vw, 2.1rem)
  border 1px solid var(--brand-line)
  border-radius 16px
  background var(--color-block)

.brand-coordinate__main
  border-top 3px solid var(--theme) !important

.brand-coordinate article > span
  display block
  margin-bottom 2.25rem
  color var(--theme)
  font-family "SFMono-Regular", "JetBrains Mono", Consolas, monospace
  font-size .7rem

.brand-coordinate h3
  margin-bottom .7rem
  color var(--color-h3)
  font-size 1.18rem

.brand-coordinate article > p:not(.brand-keywords)
  color var(--color-p)
  line-height 1.78

.brand-keywords
  margin 1.25rem 0 0 !important
  padding-top 1rem
  border-top 1px solid var(--brand-line)
  color var(--brand-muted)
  font-size .73rem
  line-height 1.8

.brand-difference
  display grid
  grid-template-columns minmax(220px, .7fr) 1.3fr
  gap clamp(2rem, 6vw, 5rem)
  margin-top clamp(4.5rem, 9vw, 7.5rem)
  padding clamp(1.75rem, 5vw, 3.5rem)
  border 1px solid var(--theme-a20)
  border-radius 20px
  background var(--color-block)

.brand-difference__points article
  padding 1.2rem 0
  border-bottom 1px solid var(--brand-line)

.brand-difference__points article:first-child
  padding-top 0

.brand-difference__points article:last-child
  padding-bottom 0
  border-bottom 0

.brand-difference h3
  margin-bottom .45rem
  color var(--color-h3)
  font-size 1.05rem

.brand-difference__points p
  margin-bottom 0
  color var(--color-p)
  line-height 1.8

.brand-proof
  display grid
  grid-template-columns .8fr 1.2fr
  gap clamp(2rem, 6vw, 5rem)
  margin-top clamp(4.5rem, 9vw, 7.5rem)
  padding 0 clamp(.25rem, 3vw, 2.2rem)

.brand-proof__copy p
  color var(--color-p)
  line-height 1.95

.brand-proof__copy p:last-child
  margin-bottom 0
  color var(--color-text)

.brand-writing
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 1rem

.brand-writing > div
  padding 1.3rem 0
  border-top 2px solid var(--theme-a30)
  border-bottom 1px solid var(--brand-line)

.brand-writing h3
  margin-bottom .55rem
  color var(--color-h3)
  font-size 1.05rem

.brand-writing p
  margin-bottom 0
  color var(--color-p)
  line-height 1.8

.brand-citation
  margin-top clamp(4.5rem, 9vw, 7.5rem)
  padding clamp(1.75rem, 5vw, 3.5rem)
  border 1px solid var(--brand-line)
  border-radius 18px
  background var(--color-block)

.brand-citation blockquote
  margin 1.4rem 0 0
  padding 0
  border 0
  color var(--color-p)
  font-size clamp(1rem, 2vw, 1.15rem)
  line-height 2

.brand-contact
  display flex
  gap 2rem
  align-items flex-end
  justify-content space-between
  margin-top clamp(4.5rem, 9vw, 7.5rem)
  padding clamp(1.75rem, 5vw, 3rem)
  border 1px solid var(--theme-a20)
  border-radius 20px
  background radial-gradient(circle at 90% 15%, var(--theme-a20), transparent 40%), var(--color-block)

.brand-contact h2
  margin-bottom .5rem

.brand-contact div > p:last-child
  max-width 36rem
  margin-bottom 0
  color var(--color-p)
  line-height 1.7

.brand-contact__links
  display flex
  gap .65rem
  flex none

.brand-contact__links a
  display inline-flex
  gap .6rem
  align-items center
  min-height 44px
  padding .7rem 1rem
  border 1px solid var(--brand-line)
  border-radius 9px
  color var(--color-text)
  font-weight 650
  transition transform .2s ease, border-color .2s ease, color .2s ease

.brand-contact__links a:first-child
  border-color var(--theme)
  background var(--theme)
  color white

.brand-contact__links a:hover
  border-color var(--theme)
  color var(--theme)
  transform translateY(-2px)

.brand-contact__links a:first-child:hover
  color white

.brand-contact__links a:active
  transform translateY(0) scale(.98)

.brand-contact__links a:focus-visible
  outline 3px solid var(--theme-a30)
  outline-offset 3px

@media screen and (max-width: 820px)
  .brand-hero
    grid-template-columns 1fr
    padding 1.35rem

  .brand-portrait
    grid-row 1
    width min(72vw, 310px)

  .brand-intro,
  .brand-difference,
  .brand-proof
    grid-template-columns 1fr
    gap 1rem

  .brand-intro .brand-section-label,
  .brand-intro h2,
  .brand-intro > p:not(.brand-section-label)
    grid-column 1

  .brand-coordinate
    grid-template-columns 1fr

  .brand-writing
    grid-template-columns 1fr

  .brand-contact
    align-items stretch
    flex-direction column

  .brand-contact__links
    flex-wrap wrap

@media screen and (max-width: 460px)
  .brand-facts
    display grid
    gap .35rem

  .brand-facts span:not(:last-child)::after
    display none

  .brand-hero h1
    font-size 2.5rem

  .brand-thesis
    padding 1.5rem

  .brand-contact__links
    display grid
    grid-template-columns 1fr

  .brand-contact__links a
    justify-content space-between
