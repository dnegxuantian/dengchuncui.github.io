<style>
html{background:#fafaf8;color:#242a30;scroll-behavior:smooth}
body{max-width:56rem;padding:3rem 2rem;margin:auto;font:17px/1.85 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
header{text-align:left!important;border-bottom:1px solid #dfe3e1;padding-bottom:1.5rem;margin-bottom:2rem}
h1{font-size:1.85rem;line-height:1.45;margin-top:4rem;scroll-margin-top:2rem}header h1{font-size:2.25rem;margin-top:0}
h2{font-size:1.35rem;line-height:1.6;margin-top:2.5rem}h3{font-size:1.12rem}
a{color:#146e73;text-decoration-thickness:1px;text-underline-offset:3px}
#TOC{border-bottom:1px solid #dfe3e1;padding-bottom:2rem;font-size:.95rem}#TOC li{margin:.4rem 0}
pre{background:#eef0ee;padding:1rem;overflow-x:auto;line-height:1.5;font-size:.85rem}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
pre code{overflow-wrap:normal}img{max-width:100%;height:auto}figure{margin:2rem 0}figcaption{font-size:.85rem;color:#65706d;line-height:1.6;margin-top:.5rem}
.book-image-link{display:block;cursor:zoom-in}.book-image-link:focus-visible{outline:3px solid #146e73;outline-offset:5px}.book-image-help{display:block;font-size:.85rem;margin-top:.4rem}
@media(min-width:1100px){figure{width:min(1180px,calc(100vw - 64px));max-width:none;position:relative;left:50%;transform:translateX(-50%)}figure img{display:block;width:100%}}
table{width:100%;font-size:.9rem;line-height:1.65}th,td{padding:.65rem;text-align:left;vertical-align:top;border-bottom:1px solid #dfe3e1}
blockquote{border-left:3px solid #9ebbb7;padding-left:1rem;color:#4e5b58}
@media(max-width:600px){body{padding:1.5rem 1rem;font-size:16px}header h1{font-size:1.7rem}h1{font-size:1.5rem}table{display:block;overflow-x:auto}}
@media print{body{background:white;font-size:11pt;max-width:none}h1{break-before:page}header h1{break-before:auto}pre{white-space:pre-wrap}img{max-height:70vh}}
</style>
