{
  "name": "chuncui-blog",
  "version": "2.0.0",
  "private": true,
  "description": "邓纯粹的技术博客，使用 Hexo 与 Volantis 构建。",
  "scripts": {
    "clean": "hexo clean",
    "build": "hexo clean && hexo generate",
    "dev": "hexo server",
    "deploy:github": "hexo clean && hexo deploy",
    "recover:legacy": "python3 tools/recover_posts.py",
    "check": "python3 tools/check_site.py public"
  },
  "engines": {
    "node": ">=20"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-deployer-git": "4.0.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-volantis": "6.8.3"
  }
}
