@startuml
title 多 Agent 共享状态控制
skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}
rectangle "Coordinator\nTask DAG + Lease + Version" as coord #E0F2FE
rectangle "Agent A\n隔离工作区" as a
rectangle "Agent B\n隔离工作区" as b
database "Artifact Store\n不可变版本 + lineage" as artifact #DCFCE7
rectangle "Merge Gate\nbase version + tests" as merge #FEF3C7
database "Operation Registry\n幂等键 + conflict key" as op #FEE2E2
rectangle "External Systems" as external
coord --> a : leased task
coord --> b : leased task
a --> artifact : version A
b --> artifact : version B
artifact --> merge
merge --> coord : accepted result
coord --> op : authorized operation
op --> external
@enduml
