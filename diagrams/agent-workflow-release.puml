@startuml
title Agent Workflow 的构建与发布链路

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "Workflow Source\nnode graph / schemas / transitions / migrations" as source #E0F2FE
rectangle "Build\n解析、静态检查、依赖锁定、content hash" as build
rectangle "不可变 Definition\nworkflow_version + Bundle refs" as def #FEF3C7
rectangle "Contract/Eval\n状态、工具、权限、失败与恢复" as test
rectangle "Canary\n新 Runs + 固定分流" as canary
rectangle "Alias\nprod -> workflow_v12" as alias #DCFCE7
rectangle "Running Instances\n继续 v11 或显式迁移" as running

source --> build
build --> def
def --> test
test --> canary
canary --> alias
alias --> running

note right of running
  发布新版本不修改已启动 Run；
  状态迁移必须有显式规则和回滚计划
end note
@enduml
