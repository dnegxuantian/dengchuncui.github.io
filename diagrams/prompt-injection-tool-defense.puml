@startuml
title 不可信内容不能直接变成工具指令

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "可信控制面\nsystem policy / tool schemas / user identity" as control #E0F2FE
rectangle "不可信数据面\n网页、文档、邮件、工具结果" as data #FEE2E2
rectangle "带来源的上下文\ncontent + source + trust label" as context
rectangle "模型建议\nanswer 或 tool proposal" as proposal #FEF3C7
rectangle "确定性策略\n权限、对象、参数、状态、确认" as policy
rectangle "隔离执行\n最小权限 / egress allowlist / timeout" as exec
rectangle "结果审计\n行为与来源关联" as audit #DCFCE7

control --> context
data --> context
context --> proposal
proposal --> policy
policy --> exec
exec --> audit

note right of data
  “忽略之前指令”只是内容；
  它不能提升来源的信任级别
end note
@enduml
