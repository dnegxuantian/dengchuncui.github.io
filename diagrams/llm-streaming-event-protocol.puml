@startuml
title 流式响应按事件归并，不按 TCP chunk 拼字符串

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "HTTP 字节流\n任意分片" as bytes #E0F2FE
rectangle "SSE Parser\n按空行定界，合并多行 data" as sse
rectangle "供应商事件\ndelta / function_call / finish / error" as native #FEF3C7
rectangle "统一事件\nseq + type + payload + observed_at" as events
rectangle "状态归并器\n文本、工具参数、usage、终态" as reducer
rectangle "完成校验\n唯一终态 / JSON 完整 / finish 映射" as verify
rectangle "持久化结果\nraw events + normalized output" as saved #DCFCE7

bytes --> sse
sse --> native
native --> events
events --> reducer
reducer --> verify
verify --> saved

note right of bytes
  网络分片不是消息边界，
  一个 JSON 可能跨多个 chunk
end note
@enduml
