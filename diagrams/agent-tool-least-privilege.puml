@startuml
title Agent 工具权限按 Run 和 Step 收敛

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "用户与目标\nsubject / tenant / task / risk" as goal #E0F2FE
rectangle "Step 所需能力\n只读元数据？预览？执行？" as need
rectangle "策略求交\n用户权限 ∩ Agent policy ∩ Tool policy" as policy #FEF3C7
rectangle "短时 Capability\naction + resource scope + expiry + budget" as cap
rectangle "最小工具视图\n仅暴露当前 Step 可用 tools" as tools
rectangle "工具内再验证\n主体、对象、状态、版本" as verify
rectangle "审计与撤销\ncapability_id / decision / operation" as audit #DCFCE7

goal --> need
need --> policy
policy --> cap
cap --> tools
tools --> verify
verify --> audit

note right of cap
  服务账户能力是上限，
  不是每次 Agent 调用的默认权限
end note
@enduml
