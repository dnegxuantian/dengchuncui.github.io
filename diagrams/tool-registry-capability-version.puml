@startuml
title 工具注册表发布的是可验证能力版本

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "工具实现\nservice + operation" as impl #E0F2FE
rectangle "Capability Manifest\ninput/output schema\npermissions / risk / idempotency" as manifest
rectangle "不可变版本\ntool@v3 + schema hashes" as version #FEF3C7
rectangle "契约测试\nhappy / error / timeout / duplicate" as tests
rectangle "Registry Alias\nprod:rerun_job -> v3" as alias #DCFCE7
rectangle "Agent Bundle\n固定 registry snapshot" as bundle
rectangle "弃用与回滚\nusage graph / compatibility window" as lifecycle

impl --> manifest
manifest --> version
version --> tests
tests --> alias
alias --> bundle
alias --> lifecycle

note right of bundle
  一次 Run 中看到的工具集合和 schema
  不能在中途漂移
end note
@enduml
