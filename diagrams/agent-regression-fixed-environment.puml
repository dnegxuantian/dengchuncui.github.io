@startuml
title Agent 回归的环境锁定清单

skinparam backgroundColor white
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam rectangle {
  BorderColor #475569
  BackgroundColor #F8FAFC
}

rectangle "Case\ninput + permissions + expected invariants" as case #E0F2FE
rectangle "Behavior Bundle\nmodel snapshot / prompt / params" as behavior
rectangle "Context Bundle\nknowledge/index/memory/time snapshot" as context
rectangle "Tool Bundle\nschemas / adapters / fixtures / state" as tools #FEF3C7
rectangle "Runtime Bundle\npolicy / router / parser / clock / budgets" as runtime
rectangle "Replay Result\nevents / operations / claims / cost" as result
rectangle "Controlled Diff\n只改变目标变量" as diff #DCFCE7

case --> behavior
behavior --> context
context --> tools
tools --> runtime
runtime --> result
result --> diff

note right of context
  知识、权限与“当前时间”不固定，
  同一问题也不再是同一实验
end note
@enduml
